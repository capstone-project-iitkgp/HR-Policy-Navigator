# OpenAI-compatible chat completions endpoint (hosted <=8B model).
CHAT_BASE_URL=https://your-endpoint.example/v1
CHAT_MODEL=your-model-name

# Local stand-in instead of the real API (python -m tools.mock_llm; see tools/mock_llm/README.md).
# Replace the three values above/below with these. Never put the real key in a file used with it.
# CHAT_BASE_URL=http://127.0.0.1:8099/v1
# CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct   # or Qwen/Qwen3-8B
# API_KEY=dummy

# Embeddings endpoint supplied with the capstone.
EMBED_BASE_URL=https://your-endpoint.example/v1
EMBED_MODEL=your-embedding-model
# Falls back to API_KEY if empty. The embeddings VM may use a different key.
EMBED_API_KEY=

# Each VM has its own CA file (path to the .crt from the course zip). Leave empty for system CAs.
CAPSTONE_CA_CERT=
EMBED_CA_CERT=

# Shared endpoint key. Copy this file to .env and fill it in locally.
API_KEY=

# Optional tracing. Use one backend: LangSmith, Langfuse, or OpenTelemetry.
LANGSMITH_API_KEY=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local API
APP_HOST=127.0.0.1
APP_PORT=8000

# Dummy HRMS (see hrms/README.md). Both are optional.
# HRMS_DB_PATH=hrms/hrms.db
# HRMS_TODAY=2026-11-16
