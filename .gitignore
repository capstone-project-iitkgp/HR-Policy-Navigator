# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets and local env
.env
.env.*
!.env.example

# Corpus rebuilt from manifests
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Dummy HRMS database is generated from hrms/seed_data (python -m hrms.seed)
hrms/*.db
hrms/*.db-journal

# LLM response and embedding caches, probe output
.cache/
probe_report.json

# Local indexes
.chroma/
qdrant_storage/

# OS and editors
.DS_Store
.idea/
.vscode/

# Endpoint CA files (mounted into Docker from ./certs)
certs/*
!certs/.gitkeep
*.crt
